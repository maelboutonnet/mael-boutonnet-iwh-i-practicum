html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 #{title}
        a(href="/") Return to the homepage

        h2 Update Form 

        form.update-form(action="/update-cobj" method="POST")
            label Music Name
            input(type="text" name="name" placeholder="" required)
            label Duration of the piece
            input(type="text" name="duration" placeholder="" required)
            label Date of composition
            input(type="date" name="date_of_composition" placeholder="" required)
            input(type="submit")